{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ustamfethiye",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Worker (www yonlendirmesi, guvenlik basliklari) sayfa isteklerinde de calissin; /assets/ haric.
    "run_worker_first": ["/*", "!/assets/*"]
  },

  // Wrangler deploy/dev oncesi statik siteyi uretir.
  // Cloudflare Workers Builds dogrudan `npx wrangler deploy` calistirdigi icin
  // build adimi burada tanimli olmak zorunda — package.json scripti CI'da calismaz.
  "build": { "command": "node build.mjs" },

  "observability": { "enabled": true },

  // Alan adlari: Cloudflare DNS kaydini ve sertifikayi kendisi olusturur.
  // www, worker.js icinde ustamfethiye.com adresine 301 ile yonlendirilir.
  "routes": [
    { "pattern": "ustamfethiye.com", "custom_domain": true },
    { "pattern": "www.ustamfethiye.com", "custom_domain": true }
  ],

  "vars": {
    "SITE_URL": "https://ustamfethiye.com",
    // Talep e-postasinin gonderen adresi (Email Routing acik alan adindan herhangi bir adres)
    "LEAD_EMAIL_FROM": "talep@ustamfethiye.com"
  },

  // Talep e-postasi: Cloudflare Email Routing uzerinden gonderim.
  // Hedef adres (LEAD_EMAIL_TO) secret olarak girilir ve Email Routing'de dogrulanmis olmalidir.
  "send_email": [{ "name": "LEAD_EMAIL" }],

  // Talepler D1'e de kaydedilir (tablo: schema.sql). E-posta kaybolsa bile kayit kalir.
  "d1_databases": [
    { "binding": "DB", "database_name": "ustamfethiye", "database_id": "f3afe3cf-f4e9-433f-ad62-d236a927b286" }
  ]

  // --- Kurulum sonrasi aktif edilecekler -------------------------------
  //
  // 1) D1 ve send_email yukarida tanimli. (D1: npx wrangler d1 create ustamfethiye,
  //    tablo: npx wrangler d1 execute ustamfethiye --remote --file=./schema.sql)
  //
  // 2) Talep e-postasinin gidecegi adres ve spam korumasi (Turnstile) icin secret ekleyin:
  //      npx wrangler secret put LEAD_EMAIL_TO
  //      npx wrangler secret put TURNSTILE_SECRET
  //    Turnstile site key'i src/content/site.js icinde tanimlanir.
  //    (Alternatif e-posta yolu: RESEND_API_KEY secret'i; Telegram icin
  //     TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID — ikisi de opsiyonel.)
  //
  // Hicbiri tanimli degilse form calismaya devam eder; talep yalnizca
  // Worker loglarina dusar (npx wrangler tail).
  // ---------------------------------------------------------------------
}
